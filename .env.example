NEXT_PUBLIC_API_URL=http://localhost:8000
MANGAFLOW_PROVIDER=mock
MANGAFLOW_IMAGE_PROVIDER=disabled
MANGAFLOW_TTS_PROVIDER=disabled
MANGAFLOW_CHECKPOINT_DIR=./data/checkpoints
# Local development defaults to org_demo/user_owner when identity headers are absent.
# Production deployments must use strict mode and bind these headers from a trusted gateway/IdP.
MANGAFLOW_AUTH_MODE=dev
# Required when MANGAFLOW_AUTH_MODE=strict; the trusted gateway signs "organization_id:user_id".
# MANGAFLOW_IDENTITY_HMAC_SECRET=replace-with-a-secret-from-your-secret-manager
# MANGAFLOW_MEDIA_ROOT=./data/media
# COMFYUI_BASE_URL=http://host.docker.internal:8188
# COMFYUI_WORKFLOW_PATH=./workflows/i2v.json
# COMFYUI_IMAGE_WORKFLOW_PATH=./workflows/keyframe.json
# CLOUD_VIDEO_BASE_URL=https://provider.example/v1
# CLOUD_VIDEO_API_KEY=
# IMAGE_PROVIDER_BASE_URL=https://image-provider.example/v1
# IMAGE_PROVIDER_API_KEY=
# IMAGE_MODEL=
# TTS_PROVIDER_BASE_URL=https://tts-provider.example/v1
# TTS_PROVIDER_API_KEY=
# TTS_MODEL=
# TTS_DEFAULT_VOICE=narrator
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Public HTTPS origin that a cloud I2V Provider can use to fetch signed keyframes.
# MANGAFLOW_PUBLIC_MEDIA_BASE_URL=https://studio.example.com
# MANGAFLOW_ARTIFACT_SIGNING_SECRET=replace-with-a-secret-from-your-secret-manager
# Comma-separated hosts allowed for Provider output downloads, e.g. signed S3/CDN origins.
# MANGAFLOW_MEDIA_DOWNLOAD_HOSTS=cdn.provider.example,bucket.s3.example.com
